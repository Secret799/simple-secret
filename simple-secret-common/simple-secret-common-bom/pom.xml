    <distributionManagement>
        <snapshotRepository>
            <id>junpzx-custom-nexus-snapshots</id>
            <name>junpzx-custom-nexus-snapshots</name>
            <url>https://repository.junpzx.cn/repository/maven-local-snapshot/</url>
        </snapshotRepository>
        <repository>
            <id>junpzx-custom-nexus-releases</id>
            <name>junpzx-custom-nexus-releases</name>
            <url>https://repository.junpzx.cn/repository/maven-local/</url>
        </repository>
    </distributionManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.3.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>bom</flattenMode>
                    <pomElements>
                        <properties>remove</properties>
                        <repositories>remove</repositories>
                        <pluginRepositories>remove</pluginRepositories>
                        <build>remove</build>
                        <dependencyManagement>resolve</dependencyManagement>
                    </pomElements>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

